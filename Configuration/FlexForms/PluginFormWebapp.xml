<T3DataStructure>
  <sheets>
    <sDEF>
      <ROOT>
          <sheetTitle>Optionen</sheetTitle>
        <type>array</type>
        <el>
          <settings.modtyp>
           <label>Typ</label>
            <config>
            <type>select</type>
            <renderType>selectSingle</renderType>
            <items type="array">
              <numIndex index="0" type="array">
                  <label>Anmeldung</label>
                <value>anmeldung</value>
              </numIndex>	   				
              <numIndex index="1" type="array">
                  <label>Anmeldung nur PLZ</label>
                <value>anmeldungplz</value>
              </numIndex>
              <numIndex index="2" type="array">
                  <label>Bearbeiten von Extern</label>
                <value>bearbeiten</value>
              </numIndex>
            </items>
            </config>
          </settings.modtyp>
          <settings.anmeldendeseite>
              <label>Anmelden Ende-Seite</label>
              <config>
                <type>group</type>
                <internal_type>db</internal_type>
              <allowed>pages</allowed>
              <size>1</size>
              <maxitems>1</maxitems>
              <minitems>0</minitems>
              <show_thumbs>1</show_thumbs>
              </config>
          </settings.anmeldendeseite>
          <settings.anmeldendeseiteaskconsent>
              <label>Seite nach Bestätigung Anforderung Einwilligung im Backend</label>
              <config>
                <type>group</type>
                <internal_type>db</internal_type>
              <allowed>pages</allowed>
              <size>1</size>
              <maxitems>1</maxitems>
              <minitems>0</minitems>
              <show_thumbs>1</show_thumbs>
              </config>
          </settings.anmeldendeseiteaskconsent>   
          <settings.mailattacheinwilligung>
                         <label>Pfad zum Dateianhang (optional)</label>
                         <config>
                             <type>input</type>
                             <size>60</size>
                         </config>
          </settings.mailattacheinwilligung>
          <settings.redirectValidationInitiated>
              <label>Seite Bestätigungsmail angefordert</label>
              <config>
                <type>group</type>
                <internal_type>db</internal_type>
              <allowed>pages</allowed>
              <size>1</size>
              <maxitems>1</maxitems>
              <minitems>0</minitems>
              <show_thumbs>1</show_thumbs>
              </config>
          </settings.redirectValidationInitiated>
           <settings.redirectValidationFailed>
              <label>Seite Validierung fehlgeschlagen</label>
              <config>
                <type>group</type>
                <internal_type>db</internal_type>
              <allowed>pages</allowed>
              <size>1</size>
              <maxitems>1</maxitems>
              <minitems>0</minitems>
              <show_thumbs>1</show_thumbs>
              </config>
          </settings.redirectValidationFailed>
          <settings.wartungvon>
                         <label>Wartung von (Format: 01.01.2020 08:00)</label>
                         <config>
                             <type>input</type>
                             <size>60</size>
                         </config>
          </settings.wartungvon>
          <settings.wartungbis>
                         <label>Wartung bis (Format: 01.01.2020 08:00)</label>
                         <config>
                             <type>input</type>
                             <size>60</size>
                         </config>
          </settings.wartungbis>
          <settings.wartungtext>
                		    <label>Wartung Text</label>
                        <config>
                            <type>text</type>
                            <cols>20</cols>
                            <rows>3</rows>
                            <eval>trim</eval>
                            <enableRichtext>1</enableRichtext>
                        </config>							
          </settings.wartungtext>
        </el>
      </ROOT>
    </sDEF>
  </sheets>
</T3DataStructure>